   <!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.kde.kstars.Ekos.Focus">
    <method name="camera">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="s"/>
    </method>
    <method name="filterWheel">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="s"/>
    </method>
    <method name="filter">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="s"/>
    </method>
    <method name="setFilter">
      <arg direction="in" type="s" name="filter"/>
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="focuser">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="s"/>
    </method>
    <method name="status">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="(i)"/>
      <annotation value="Ekos::FocusState" name="org.qtproject.QtDBus.QtTypeName.Out0"/>
    </method>
    <method name="start">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="abort">
      <arg direction="in" type="s" name="trainname"/>
      <annotation value="true" name="org.freedesktop.DBus.Method.NoReply"/>
    </method>
    <method name="capture">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="in" type="d" name="settleTime"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="focusIn">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
      <arg direction="in" type="i" name="ms"/>
    </method>
    <method name="focusOut">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
      <arg direction="in" type="i" name="ms"/>
    </method>
    <method name="checkFocus">
      <arg direction="in" type="d" name="requiredHFR"/>
      <arg direction="in" type="s" name="trainname"/>
      <annotation value="true" name="org.freedesktop.DBus.Method.NoReply"/>
    </method>
    <method name="canAutoFocus">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="useFullField">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="setBinning">
      <arg direction="in" type="i" name="binX"/>
      <arg direction="in" type="i" name="binY"/>
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="setAutoStarEnabled">
      <arg direction="in" type="b" name="enable"/>
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="setAutoSubFrameEnabled">
      <arg direction="in" type="b" name="enable"/>
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="setAutoFocusParameters">
      <arg direction="in" type="s" name="trainname"/>
      <arg direction="in" type="i" name="boxSize"/>
      <arg direction="in" type="i" name="stepSize"/>
      <arg direction="in" type="i" name="maxTravel"/>
      <arg direction="in" type="d" name="tolerance"/>
      <arg direction="out" type="b"/>
    </method>
    <method name="resetFrame">
      <arg direction="in" type="s" name="trainname"/>
      <annotation value="true" name="org.freedesktop.DBus.Method.NoReply"/>
    </method>
    <signal name="newStatus">
      <arg direction="out" type="(i)" name="status"/>
      <arg direction="out" type="s" name="trainname"/>
      <annotation value="Ekos::FocusState" name="org.qtproject.QtDBus.QtTypeName.Out0"/>
    </signal>
    <signal name="newLog">
      <arg direction="out" type="s" name="text"/>
    </signal>
    <signal name="newHFR">
      <arg direction="out" type="d" name="HFR"/>
      <arg direction="out" type="i" name="position"/>
      <arg direction="out" type="b" name="inAutofocus"/>
      <arg direction="out" type="s" name="trainname"/>
    </signal>
  </interface>
  <interface name="org.freedesktop.DBus.Properties">
    <method name="Get">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="Set">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <method name="GetAll">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="values" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <signal name="PropertiesChanged">
      <arg name="interface_name" type="s" direction="out"/>
      <arg name="changed_properties" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg name="invalidated_properties" type="as" direction="out"/>
    </signal>
  </interface>
  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg name="xml_data" type="s" direction="out"/>
    </method>
  </interface>
  <interface name="org.freedesktop.DBus.Peer">
    <method name="Ping"/>
    <method name="GetMachineId">
      <arg name="machine_uuid" type="s" direction="out"/>
    </method>
  </interface>
</node>
