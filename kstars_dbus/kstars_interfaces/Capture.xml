      <arg direction="out" type="i" name="cameraID"/>
      <annotation value="Ekos::CaptureState" name="org.qtproject.QtDBus.QtTypeName.Out0"/>
    </signal>
    <signal name="captureComplete">
      <arg direction="out" type="a{sv}" name="metadata"/>
      <arg direction="out" type="s" name="train"/>
      <annotation value="QVariantMap" name="org.qtproject.QtDBus.QtTypeName.In0"/>
      <annotation value="QVariantMap" name="org.qtproject.QtDBus.QtTypeName.Out0"/>
    </signal>
